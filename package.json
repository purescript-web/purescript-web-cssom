{
  "private": true,
  "scripts": {
    "build": "spago build -p web-cssom --pedantic-packages --strict",
    "lint": "oxlint --deny-warnings src",
    "format": "purs-tidy format-in-place src && oxfmt --write 'src/**/*.js'",
    "format:check": "purs-tidy check src && oxfmt --check 'src/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purs-tidy": "0.11.1",
    "purescript": "0.15.16",
    "spago": "1.0.4"
  }
}
